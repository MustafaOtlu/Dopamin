# Yerel PostgreSQL (PGlite), kalıcı veriyi .data/ içinde tutar.
APP_ORIGIN=http://127.0.0.1:3000
AUTH_PROVIDER=local
PGLITE_PATH=.data/postgres
STORAGE_PATH=.data/files
APP_TIMEZONE=Europe/Istanbul
# İlk doğrulanmış yerel akademisyen hesabı için davet. Canlıda local auth kapalıdır.
TEACHER_INVITE_CODE=

# Canlı: AUTH_PROVIDER=supabase, yönetilen PostgreSQL ve özel Storage gereklidir.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=course-documents

# OpenAI uyumlu structured-output sağlayıcısı. Anahtar yoksa üretim başlamaz.
# gemini: Google Interactions API; openai: Responses API
AI_PROVIDER=gemini
AI_API_KEY=
# Only used by the openai provider; Gemini uses the official Google endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-3.5-flash-lite
# Kalite odaklı varsayılan. Daha düşük gecikme için low; modelin desteklediği düzeyi seç.
AI_GEMINI_THINKING_LEVEL=medium
AI_DAILY_BUDGET_USD=5
# Seçilen modelin geçerli standart fiyatları: milyon token başına USD.
# Anahtar/model ile birlikte zorunludur; bütçe faturanın yerine geçmez.
AI_INPUT_USD_PER_MILLION=0.30
AI_OUTPUT_USD_PER_MILLION=2.50

# Yerel Türkçe/İngilizce OCR; dağıtımdan önce npm run ocr:prepare.
OCR_ENABLED=1
OCR_CACHE_PATH=.data/ocr
